# api.siteread.dev: the feed, the share endpoint, the benchmark JSON, the operator status.
# Both jobs run on the process's own timers (feed every 6 h, aggregate hourly), so there are no
# timer units. Secrets come from /etc/siteread/env (cloud/deploy/install.sh makes it).

[Unit]
Description=siteread cloud (api.siteread.dev)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=siteread
Group=siteread
EnvironmentFile=/etc/siteread/env
Environment=NODE_ENV=production
ExecStart=/opt/node/bin/node /srv/siteread/current/cloud/bin/serve.js --host 127.0.0.1 --port 8787 --data /var/lib/siteread --public-url https://siteread.dev
StateDirectory=siteread
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
# SIGTERM makes serve.js write its request counts before it exits.
KillSignal=SIGTERM
TimeoutStopSec=15

MemoryMax=256M
CPUQuota=50%

# It reads its code, writes only its data dir, and talks to the proxy and the vendors' lists.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# No MemoryDenyWriteExecute: V8's JIT writes the code it runs.
RemoveIPC=yes
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
