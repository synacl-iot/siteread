# siteread.dev: the Angular SSR server (site/), shipped as built files only.
# The heap cap keeps it near 180 MB: V8 otherwise grows its heap lazily to ~245 MB (HOSTING.md).

[Unit]
Description=siteread site (siteread.dev)
After=network-online.target siteread-cloud.service
Wants=network-online.target

[Service]
Type=simple
User=siteread
Group=siteread
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4000
Environment=SITEREAD_API_INTERNAL=http://127.0.0.1:8787
WorkingDirectory=/srv/siteread/current/site
ExecStart=/opt/node/bin/node --max-old-space-size=96 /srv/siteread/current/site/server/server.mjs
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

MemoryMax=320M
CPUQuota=50%

# It reads its own files and talks to the service on loopback; it writes nothing.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# No MemoryDenyWriteExecute: V8's JIT writes the code it runs.
RemoveIPC=yes
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
